# Copy to .env and adjust.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Needed when testing through a tunnel/HTTPS host, e.g. https://abc123.ngrok-free.app
# CSRF_TRUSTED_ORIGINS=https://abc123.ngrok-free.app

# Optional: PostgreSQL instead of SQLite
# DATABASE_URL=postgres://photobooth:secret@localhost:5432/photobooth

# Optional: Redis channel layer (required in production / with more than one server process)
# REDIS_URL=redis://localhost:6379/0

# Optional: real email for password resets (default prints emails to the console)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
